---
import { getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

// Prerendered at build time and served from the CDN. The Markdown twin an
// agent would want lives next door at `[...id].md.ts`, generated from the same
// collection entry, so no request-time negotiation is needed.
export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BlogPost {...post.data} ogImage={`/og/${post.id}.png`}>
	<Content />
</BlogPost>
