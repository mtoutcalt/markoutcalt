---
import { getEntry, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

// Rendered on demand rather than prerendered so `src/middleware.ts` can serve
// the Markdown variant of a post to agents that ask for it. The sitemap still
// lists every post via `customPages` in astro.config.mjs.
export const prerender = false;

const { id } = Astro.params;
const post = id ? await getEntry('blog', id) : undefined;

if (!post) {
	return new Response(null, { status: 404, statusText: 'Not found' });
}

const { Content } = await render(post);
---

<BlogPost {...post.data} ogImage={`/og/${post.id}.png`}>
	<Content />
</BlogPost>
