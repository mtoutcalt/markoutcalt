---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ShelfDecor from "../components/ShelfDecor.astro";
import { books } from "../data/books.js";

const pageTitle = "My Bookshelf";
const pageDescription = "A collection of books that have influenced my thinking on software development and beyond.";

const STATUS_LABELS: Record<string, string> = {
  read: "Read",
  reading: "Reading",
  "want-to-read": "Want to read",
};

type Book = (typeof books)[number];
type DecorKind = "bush" | "cactus" | "frame" | "topiary";
type ShelfItem =
  | { type: "book"; book: Book; index: number }
  | { type: "decor"; kind: DecorKind };

// Ornaments stand among the books the way they would on a real case: one after
// the second book, then every fifth, and one closing out the collection.
const DECOR_KINDS: DecorKind[] = ["bush", "cactus", "frame", "topiary"];
const DECOR_EVERY = 5;

const items: ShelfItem[] = [];
books.forEach((book, index) => {
  items.push({ type: "book", book, index });
  if (index % DECOR_EVERY === 1 || index === books.length - 1) {
    const kind = DECOR_KINDS[items.filter((i) => i.type === "decor").length % DECOR_KINDS.length];
    items.push({ type: "decor", kind });
  }
});

// Size the case to the collection so it always looks stocked: at least two
// shelves, and at most 12 slots wide before it grows another shelf. The grid
// itself uses auto-fill, so narrow screens simply get more, shorter shelves.
const perRow = Math.min(12, Math.max(4, Math.ceil(items.length / 2)));
const rows = Math.ceil(items.length / perRow);

const countBy = (key: "status" | "genre", value: string) =>
  books.filter((book) => book[key] === value).length;
const statuses = Object.keys(STATUS_LABELS).filter((status) => countBy("status", status) > 0);
const genres = [...new Set(books.map((book) => book.genre))].sort();

// Shown behind a cover if its image fails to load.
const FALLBACK_COLORS = ["#8c2f39", "#1d4e89", "#2d6a4f", "#5b3f8c", "#9a5b1e"];
---

<html lang="en">
<head>
  <BaseHead title={pageTitle} description={pageDescription} />
  <style>
    main.bookshelf-page {
      width: 1180px;
    }

    .shelf-wrap {
      /* One slot per book or ornament. */
      --cover-w: 78px;
      /* Between a trade paperback (2:3) and a tech book (3:4), so object-fit
         crops neither much. */
      --cover-h: calc(var(--cover-w) * 1.4);
      --gap: 14px;
      --row-h: calc(var(--cover-h) + 58px);
      --end-pad: 38px;  /* room for a bookend at each end of a shelf */
      --bookend-w: 14px;
      --board-h: 30px;  /* shelf board: top surface + front lip */
      --lip-h: 17px;
      --sink: 8px;      /* how far a book's foot sits into the board's top surface */
      --frame-x: 18px;
      --shelf-top: calc(var(--row-h) - var(--board-h));
      --shelf-lip: calc(var(--row-h) - var(--lip-h));

      /* Wood and bookends look the same in both themes. */
      --wood: #a8652d;
      --wood-dark: #8a4f22;
      --wood-deep: #6c3b16;
      --wood-light: #c98a4f;
      --bookend: #373f50;
      --bookend-light: #4f5a6f;

      --control-bg: #1d1d1d;
      --control-border: #3b3b3b;
      --control-border-hover: #5f5f5f;

      /* Exactly --per-row slots, plus slack that is less than one more slot so
         auto-fill never squeezes in an extra column. */
      max-width: calc(
        var(--per-row) * (var(--cover-w) + var(--gap)) - var(--gap)
        + 2 * var(--end-pad) + 2 * var(--frame-x) + 2px + 48px
      );
      margin: 0 auto;
    }

    html[data-theme='light'] .shelf-wrap {
      --control-bg: #ffffff;
      --control-border: #d8d1c4;
      --control-border-hover: #a99f8c;
    }

    .shelf-intro h1 {
      font-size: 2.5rem;
      color: var(--color-theme-1);
      margin: 0 0 0.35rem;
      font-family: var(--font-heading);
    }

    .shelf-intro p {
      color: var(--text-muted);
      font-size: 1.05rem;
      margin: 0;
    }

    /* ---------- Controls ---------- */

    .shelf-controls {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin: 1.5rem 0 1rem;
    }

    .control {
      position: relative;
      display: inline-flex;
      align-items: center;
      gap: 7px;
      height: 38px;
      padding: 0 11px;
      font-family: var(--font-body);
      font-size: 16px;
      line-height: 1;
      color: var(--text-color);
      background: var(--control-bg);
      border: 1px solid var(--control-border);
      border-radius: 7px;
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.06);
      cursor: pointer;
      transition: border-color 0.15s ease, background-color 0.15s ease;
    }

    .control:hover {
      border-color: var(--control-border-hover);
    }

    .control:focus-within,
    button.control:focus-visible {
      outline: 2px solid var(--color-theme-2);
      outline-offset: 2px;
    }

    /* The native select sits invisibly over the styled label, so it keeps the
       platform picker and keyboard behaviour. */
    .control select {
      position: absolute;
      inset: 0;
      width: 100%;
      opacity: 0;
      cursor: pointer;
      font-size: 16px;
      color-scheme: dark;
    }

    html[data-theme='light'] .control select {
      color-scheme: light;
    }

    .control svg {
      width: 16px;
      height: 16px;
      flex: none;
      fill: none;
      stroke: currentColor;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .control .control-chevron {
      width: 14px;
      height: 14px;
      opacity: 0.7;
    }

    .control-count {
      color: var(--text-muted);
      font-size: 0.9em;
    }

    /* ---------- Bookcase ---------- */

    .bookcase {
      position: relative;
      padding: 34px var(--frame-x) 18px;
      background: linear-gradient(90deg,
        var(--wood-dark),
        var(--wood) 12px,
        var(--wood) calc(100% - 12px),
        var(--wood-dark));
      border: 1px solid var(--wood-deep);
      border-radius: 6px;
      box-shadow:
        0 7px 0 -1px var(--wood-deep),
        0 34px 40px -20px rgba(0, 0, 0, 0.55);
    }

    /* Crown moulding along the top */
    .bookcase::before {
      content: '';
      position: absolute;
      top: 6px;
      left: 6px;
      right: 6px;
      height: 20px;
      border-radius: 3px;
      background: linear-gradient(to bottom,
        rgba(255, 255, 255, 0.2) 0 1px,
        var(--wood-light) 1px 4px,
        var(--wood) 4px 9px,
        var(--wood-dark) 9px 11px,
        var(--wood) 11px 17px,
        rgba(0, 0, 0, 0.22) 17px 20px);
      pointer-events: none;
    }

    /* Brass-ish screw caps in the four corners */
    .bookcase::after {
      --knob: radial-gradient(circle,
        #bd7c42 0 3px,
        var(--wood-deep) 3.5px 4.5px,
        var(--wood-light) 5px 6px,
        rgba(0, 0, 0, 0.3) 6.5px 7px,
        transparent 7.5px);
      content: '';
      position: absolute;
      inset: 0;
      background:
        var(--knob) left 5px top 8px / 16px 16px no-repeat,
        var(--knob) right 5px top 8px / 16px 16px no-repeat,
        var(--knob) left 5px bottom 1px / 16px 16px no-repeat,
        var(--knob) right 5px bottom 1px / 16px 16px no-repeat;
      pointer-events: none;
    }

    .bookcase-back {
      position: relative;
      border-radius: 2px;
      background:
        repeating-linear-gradient(90deg,
          rgba(0, 0, 0, 0.035) 0 1px,
          transparent 1px 7px,
          rgba(255, 255, 255, 0.03) 7px 8px,
          transparent 8px 13px),
        linear-gradient(to bottom, #9b5b27, var(--wood) 35%, #a3612b);
      box-shadow:
        inset 0 12px 14px -10px rgba(0, 0, 0, 0.5),
        inset 10px 0 12px -10px rgba(0, 0, 0, 0.4),
        inset -10px 0 12px -10px rgba(0, 0, 0, 0.4);
    }

    /* Grain on each shelf board's top surface. A gradient can't be clipped
       to a band on its own, so the ribs span the whole back panel and a mask
       repeated once per row shows them only on the boards. */
    .bookcase-back::before {
      content: '';
      position: absolute;
      inset: 0;
      background: repeating-linear-gradient(90deg,
        rgba(255, 255, 255, 0.12) 0 1px,
        transparent 1px 4px,
        rgba(0, 0, 0, 0.12) 4px 5px,
        transparent 5px 7px);
      -webkit-mask: linear-gradient(to bottom,
        transparent var(--shelf-top),
        #000 var(--shelf-top) var(--shelf-lip),
        transparent var(--shelf-lip)) 0 0 / 100% var(--row-h) repeat-y;
      mask: linear-gradient(to bottom,
        transparent var(--shelf-top),
        #000 var(--shelf-top) var(--shelf-lip),
        transparent var(--shelf-lip)) 0 0 / 100% var(--row-h) repeat-y;
      pointer-events: none;
    }

    /* The shelves are the grid's background, repeated once per row, so any
       number of books reflows onto as many shelves as it needs — including
       after a filter hides some — with no layout script. */
    .shelf-grid {
      --foot: calc(var(--shelf-top) + var(--sink));
      --bookend-h: calc(var(--cover-h) * 0.68);
      --bookend-x: calc((var(--end-pad) - var(--bookend-w)) / 2);

      display: grid;
      grid-template-columns: repeat(auto-fill, var(--cover-w));
      grid-auto-rows: var(--row-h);
      column-gap: var(--gap);
      justify-content: space-between;
      min-height: calc(var(--rows) * var(--row-h));
      margin: 0;
      padding: 0 var(--end-pad);
      list-style: none;
      background:
        /* bookend highlights */
        linear-gradient(to bottom,
          transparent calc(var(--foot) - var(--bookend-h)),
          var(--bookend-light) 0 var(--foot),
          transparent 0)
          left var(--bookend-x) top 0 / 3px var(--row-h) repeat-y,
        linear-gradient(to bottom,
          transparent calc(var(--foot) - var(--bookend-h)),
          var(--bookend-light) 0 var(--foot),
          transparent 0)
          right calc(var(--bookend-x) + var(--bookend-w) - 3px) top 0 / 3px var(--row-h) repeat-y,
        /* bookends */
        linear-gradient(to bottom,
          transparent calc(var(--foot) - var(--bookend-h)),
          var(--bookend) 0 var(--foot),
          transparent 0)
          left var(--bookend-x) top 0 / var(--bookend-w) var(--row-h) repeat-y,
        linear-gradient(to bottom,
          transparent calc(var(--foot) - var(--bookend-h)),
          var(--bookend) 0 var(--foot),
          transparent 0)
          right var(--bookend-x) top 0 / var(--bookend-w) var(--row-h) repeat-y,
        /* shelf board, plus the shadow it casts on the back panel below */
        linear-gradient(to bottom,
          rgba(0, 0, 0, 0.28) 0,
          transparent 18px,
          transparent var(--shelf-top),
          #8b5024 var(--shelf-top),
          #b06c33 var(--shelf-lip),
          #d99c60 var(--shelf-lip) calc(var(--shelf-lip) + 2px),
          #95562a calc(var(--shelf-lip) + 2px),
          #7a4420 var(--row-h))
          0 0 / 100% var(--row-h) repeat-y;
    }

    .shelf-item {
      position: relative;
      display: flex;
      align-items: flex-end;
      justify-content: center;
      padding-bottom: calc(var(--board-h) - var(--sink));
    }

    .shelf-item[hidden] {
      display: none;
    }

    /* Contact shadow where each item meets the shelf */
    .shelf-item::after {
      content: '';
      position: absolute;
      left: 4%;
      right: 4%;
      bottom: calc(var(--board-h) - var(--sink) - 4px);
      height: 8px;
      background: radial-gradient(closest-side, rgba(0, 0, 0, 0.4), transparent);
      pointer-events: none;
    }

    .book {
      position: relative;
      z-index: 1;
      display: block;
      width: var(--cover-w);
      height: var(--cover-h);
      padding: 0;
      border: 0;
      border-radius: 2px 3px 3px 2px;
      background: var(--fallback);
      cursor: pointer;
      box-shadow:
        1px 2px 3px rgba(0, 0, 0, 0.35),
        3px 6px 12px rgba(0, 0, 0, 0.22);
      transform-origin: center bottom;
      transition:
        transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1),
        box-shadow 0.2s ease;
    }

    /* Spine crease and a little gloss so a flat cover reads as a book */
    .book::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: inherit;
      background:
        linear-gradient(90deg,
          rgba(0, 0, 0, 0.3) 0,
          rgba(255, 255, 255, 0.22) 2px,
          rgba(0, 0, 0, 0.12) 4px,
          transparent 8px),
        linear-gradient(135deg, rgba(255, 255, 255, 0.14), transparent 45%);
      pointer-events: none;
    }

    .book:hover,
    .book:focus-visible {
      transform: translateY(-8px);
      box-shadow:
        1px 3px 4px rgba(0, 0, 0, 0.3),
        4px 14px 20px rgba(0, 0, 0, 0.3);
    }

    .book:focus-visible {
      outline: 3px solid #fffaf0;
      outline-offset: 2px;
    }

    .book.is-picked {
      transform: translateY(-18px) rotate(-2deg);
      box-shadow:
        0 0 0 3px #ffe7a3,
        4px 18px 24px rgba(0, 0, 0, 0.35);
    }

    .book-cover {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      max-width: none;
      object-fit: cover;
      border-radius: inherit;
    }

    .book-fallback {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 8px 6px 8px 10px;
      overflow: hidden;
      overflow-wrap: anywhere;
      color: #fff;
      font-family: var(--font-heading);
      font-size: 12px;
      line-height: 1.2;
      text-align: center;
    }

    .book-tooltip {
      position: absolute;
      left: 50%;
      bottom: calc(100% + 10px);
      z-index: 2;
      padding: 5px 9px;
      border-radius: 5px;
      background: rgba(24, 18, 13, 0.92);
      color: #fff;
      font-family: var(--font-body);
      font-size: 14px;
      line-height: 1.2;
      white-space: nowrap;
      opacity: 0;
      transform: translate(-50%, 4px);
      transition: opacity 0.15s ease, transform 0.15s ease;
      pointer-events: none;
    }

    .book:hover .book-tooltip,
    .book:focus-visible .book-tooltip {
      opacity: 1;
      transform: translate(-50%, 0);
    }

    .shelf-decor :global(.decor) {
      display: block;
      width: auto;
    }

    .shelf-decor :global(.decor-bush) { height: calc(var(--cover-h) * 0.56); }
    .shelf-decor :global(.decor-cactus) { height: calc(var(--cover-h) * 0.8); }
    .shelf-decor :global(.decor-topiary) { height: calc(var(--cover-h) * 0.72); }
    .shelf-decor :global(.decor-frame) {
      height: calc(var(--cover-h) * 0.5);
      transform: rotate(-4deg);
      transform-origin: center bottom;
    }

    .shelf-empty {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      margin: 0;
      padding: 0.5rem 1rem;
      border-radius: 4px;
      background: #f6ecd9;
      color: #4a3520;
      font-size: 1rem;
      white-space: nowrap;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
    }

    .shelf-empty[hidden] {
      display: none;
    }

    /* ---------- Modal ---------- */

    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.8);
      backdrop-filter: blur(8px);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 1000;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.3s ease, visibility 0s linear 0.3s;
    }

    .modal-overlay.visible {
      opacity: 1;
      visibility: visible;
      transition: opacity 0.3s ease, visibility 0s linear 0s;
    }

    .book-modal {
      background: var(--bg-color);
      color: var(--text-color);
      border-radius: 12px;
      max-width: 600px;
      width: 90%;
      max-height: 90vh;
      overflow-y: auto;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
      transform: scale(0.9);
      transition: transform 0.3s ease;
    }

    .modal-overlay.visible .book-modal {
      transform: scale(1);
    }

    .modal-header {
      display: flex;
      gap: 1.25rem;
      align-items: flex-start;
      padding: 2rem;
      border-bottom: 1px solid rgba(var(--shadow-color), 0.1);
    }

    .modal-cover {
      flex: none;
      width: 84px;
      height: 126px;
      object-fit: cover;
      border-radius: 3px;
      box-shadow: 2px 4px 12px rgba(0, 0, 0, 0.35);
    }

    .modal-cover[hidden] {
      display: none;
    }

    .modal-title {
      font-size: 1.8rem;
      color: var(--color-theme-1);
      margin-bottom: 0.5rem;
      font-family: var(--font-heading);
    }

    .modal-author {
      font-size: 1.1rem;
      font-style: italic;
      color: var(--text-muted);
      font-family: var(--font-body);
      margin-bottom: 0.75rem;
    }

    .modal-genre {
      display: inline-block;
      padding: 2px 10px;
      border: 1px solid var(--hr-color);
      border-radius: 999px;
      font-size: 0.8rem;
      color: var(--text-muted);
    }

    .modal-body {
      padding: 2rem;
    }

    .modal-year {
      font-size: 0.9rem;
      color: var(--text-muted);
      margin-bottom: 1rem;
    }

    .modal-summary {
      line-height: 1.7;
      font-family: var(--font-body);
      font-size: 1.05rem;
    }

    .modal-footer {
      padding: 1.5rem 2rem;
      border-top: 1px solid rgba(var(--shadow-color), 0.1);
      display: flex;
      gap: 1rem;
      justify-content: flex-end;
    }

    .modal-button {
      padding: 0.75rem 1.5rem;
      border-radius: 8px;
      border: none;
      cursor: pointer;
      font-size: 1.1rem;
      font-weight: 600;
      /* Not `all`: that includes the visibility inherited from the overlay,
         which then animates from hidden and makes focus() on open a no-op. */
      transition: background-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
      font-family: var(--font-heading);
    }

    .modal-link-button {
      background: var(--color-theme-1);
      color: var(--on-accent);
      text-decoration: none;
      display: inline-block;
    }

    .modal-link-button[hidden] {
      display: none;
    }

    .modal-link-button:hover {
      background: var(--color-theme-2);
      transform: translateY(-2px);
    }

    .modal-close-button {
      background: rgba(var(--shadow-color), 0.1);
      color: var(--text-color);
    }

    .modal-close-button:hover {
      background: rgba(var(--shadow-color), 0.2);
    }

    @media (max-width: 720px) {
      .shelf-wrap {
        --cover-w: 62px;
        --gap: 10px;
        --row-h: calc(var(--cover-h) + 50px);
        --end-pad: 26px;
        --bookend-w: 12px;
        --board-h: 26px;
        --lip-h: 15px;
        --sink: 7px;
        --frame-x: 12px;
      }

      .shelf-intro h1 {
        font-size: 2rem;
      }

      .shelf-controls {
        gap: 6px;
      }

      .control {
        gap: 5px;
        padding: 0 9px;
        font-size: 15px;
      }

      .bookcase {
        padding-top: 30px;
      }

      /* Touch screens have no hover, and the modal already names the book */
      .book-tooltip {
        display: none;
      }

      .modal-header {
        padding: 1.5rem;
      }

      .modal-body {
        padding: 1.5rem;
      }

      .modal-footer {
        padding: 1rem 1.5rem;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .book,
      .book-tooltip,
      .modal-overlay,
      .book-modal {
        transition: none;
      }

      .book.is-picked {
        transform: none;
      }
    }
  </style>
</head>
<body>
  <Header />
  <main class="bookshelf-page">
    <div class="shelf-wrap" style={`--per-row: ${perRow}; --rows: ${rows};`}>
      <div class="shelf-intro">
        <h1>{pageTitle}</h1>
        <p>{pageDescription}</p>
      </div>

      <div class="shelf-controls">
        <div class="control">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 4h18l-7 8.5V19l-4 2v-8.5z" /></svg>
          <span><span id="statusLabel">All</span> <span class="control-count" id="bookCount">({books.length})</span></span>
          <svg class="control-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
          <select id="statusFilter" aria-label="Filter by reading status">
            <option value="all" data-label="All">All ({books.length})</option>
            {statuses.map((status) => (
              <option value={status} data-label={STATUS_LABELS[status]}>
                {STATUS_LABELS[status]} ({countBy("status", status)})
              </option>
            ))}
          </select>
        </div>

        <div class="control">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12.6 2.6A2 2 0 0 0 11.2 2H4a2 2 0 0 0-2 2v7.2a2 2 0 0 0 .6 1.4l8.7 8.7a2.4 2.4 0 0 0 3.4 0l6.6-6.6a2.4 2.4 0 0 0 0-3.4z" /><circle cx="7.5" cy="7.5" r="1.5" /></svg>
          <span id="genreLabel">Genre</span>
          <svg class="control-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
          <select id="genreFilter" aria-label="Filter by genre">
            <option value="all">All genres</option>
            {genres.map((genre) => (
              <option value={genre}>{genre} ({countBy("genre", genre)})</option>
            ))}
          </select>
        </div>

        <button type="button" class="control" id="randomBook">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 18h1.4c1.3 0 2.5-.6 3.3-1.7l6.1-8.6c.7-1.1 2-1.7 3.3-1.7H22" /><path d="m18 2 4 4-4 4" /><path d="M2 6h1.9c1.5 0 2.9.9 3.6 2.2" /><path d="M22 18h-5.9c-1.3 0-2.6-.7-3.3-1.8l-.5-.8" /><path d="m18 14 4 4-4 4" /></svg>
          Random
        </button>
      </div>

      <section class="bookcase" aria-label="Bookshelf">
        <div class="bookcase-back">
          <ul class="shelf-grid" role="list">
            {items.map((item) =>
              item.type === "book" ? (
                <li class="shelf-item" data-status={item.book.status} data-genre={item.book.genre}>
                  <button
                    type="button"
                    class="book"
                    data-book-index={item.index}
                    aria-label={`${item.book.fullTitle} by ${item.book.fullAuthor}`}
                    style={`--fallback: ${FALLBACK_COLORS[item.index % FALLBACK_COLORS.length]};`}
                  >
                    <span class="book-fallback">{item.book.shortTitle}</span>
                    <img
                      src={item.book.coverImage}
                      alt=""
                      class="book-cover"
                      width="78"
                      height="109"
                      loading="lazy"
                      decoding="async"
                    />
                    <span class="book-tooltip" aria-hidden="true">{item.book.shortTitle}</span>
                  </button>
                </li>
              ) : (
                <li class="shelf-item shelf-decor" aria-hidden="true">
                  <ShelfDecor kind={item.kind} />
                </li>
              )
            )}
          </ul>
          <p class="shelf-empty" id="shelfEmpty" hidden>No books match those filters.</p>
        </div>
      </section>
    </div>
  </main>

  <!-- Modal -->
  <div class="modal-overlay" id="bookModalOverlay">
    <div class="book-modal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
      <div class="modal-header">
        <img id="modalCover" class="modal-cover" alt="" />
        <div>
          <h2 class="modal-title" id="modalTitle"></h2>
          <p class="modal-author" id="modalAuthor"></p>
          <span class="modal-genre" id="modalGenre"></span>
        </div>
      </div>
      <div class="modal-body">
        <p class="modal-year" id="modalYear"></p>
        <p class="modal-summary" id="modalSummary"></p>
      </div>
      <div class="modal-footer">
        <a id="modalLink" href="#" target="_blank" rel="noopener noreferrer" class="modal-button modal-link-button">
          Learn More
        </a>
        <button id="modalClose" class="modal-button modal-close-button">
          Close
        </button>
      </div>
    </div>
  </div>

  <Footer />

  <script is:inline define:vars={{ booksData: books }}>
    document.addEventListener('DOMContentLoaded', () => {
      const bookButtons = [...document.querySelectorAll('.book')];
      const statusFilter = document.getElementById('statusFilter');
      const genreFilter = document.getElementById('genreFilter');
      const statusLabel = document.getElementById('statusLabel');
      const genreLabel = document.getElementById('genreLabel');
      const bookCount = document.getElementById('bookCount');
      const shelfEmpty = document.getElementById('shelfEmpty');
      const randomButton = document.getElementById('randomBook');
      const modalOverlay = document.getElementById('bookModalOverlay');
      const modalCover = document.getElementById('modalCover');
      const modalTitle = document.getElementById('modalTitle');
      const modalAuthor = document.getElementById('modalAuthor');
      const modalGenre = document.getElementById('modalGenre');
      const modalYear = document.getElementById('modalYear');
      const modalSummary = document.getElementById('modalSummary');
      const modalLink = document.getElementById('modalLink');
      const modalClose = document.getElementById('modalClose');
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      let opener = null;
      let lastPick = null;

      // A cover that fails to load drops away to reveal the lettered cover
      // underneath, instead of leaving a broken-image box on the shelf.
      bookButtons.forEach((button) => {
        const img = button.querySelector('.book-cover');
        const hide = () => { img.hidden = true; };
        if (img.complete && img.naturalWidth === 0) hide();
        else img.addEventListener('error', hide);
      });

      const itemOf = (button) => button.closest('.shelf-item');

      function applyFilters() {
        const status = statusFilter.value;
        const genre = genreFilter.value;
        let visible = 0;

        bookButtons.forEach((button) => {
          const item = itemOf(button);
          const show = (status === 'all' || item.dataset.status === status)
            && (genre === 'all' || item.dataset.genre === genre);
          item.hidden = !show;
          if (show) visible++;
        });

        statusLabel.textContent = statusFilter.selectedOptions[0].dataset.label;
        genreLabel.textContent = genre === 'all' ? 'Genre' : genre;
        bookCount.textContent = `(${visible})`;
        shelfEmpty.hidden = visible > 0;
      }

      function openModal(button) {
        const book = booksData[Number(button.dataset.bookIndex)];
        if (!book) return;

        const coverFailed = button.querySelector('.book-cover').hidden;
        modalCover.hidden = coverFailed;
        if (!coverFailed) modalCover.src = book.coverImage;
        modalTitle.textContent = book.fullTitle;
        modalAuthor.textContent = `by ${book.fullAuthor}`;
        modalGenre.textContent = book.genre;
        modalYear.textContent = `Published: ${book.year}`;
        modalSummary.textContent = book.summary;

        const hasLink = Boolean(book.link) && book.link !== '#';
        modalLink.hidden = !hasLink;
        if (hasLink) modalLink.href = book.link;

        opener = button;
        modalOverlay.classList.add('visible');
        document.body.style.overflow = 'hidden';
        modalClose.focus();
      }

      function closeModal() {
        modalOverlay.classList.remove('visible');
        document.body.style.overflow = '';
        bookButtons.forEach((button) => button.classList.remove('is-picked'));
        if (opener) opener.focus();
        opener = null;
      }

      // Pull a random visible book off the shelf, then open it.
      function pickRandom() {
        const candidates = bookButtons.filter((button) => !itemOf(button).hidden);
        if (candidates.length === 0) return;
        const pool = candidates.length > 1 ? candidates.filter((b) => b !== lastPick) : candidates;
        const pick = pool[Math.floor(Math.random() * pool.length)];
        lastPick = pick;

        pick.classList.add('is-picked');
        pick.scrollIntoView({ block: 'nearest', behavior: reduceMotion.matches ? 'auto' : 'smooth' });
        setTimeout(() => openModal(pick), reduceMotion.matches ? 0 : 450);
      }

      statusFilter.addEventListener('change', applyFilters);
      genreFilter.addEventListener('change', applyFilters);
      randomButton.addEventListener('click', pickRandom);
      // Browsers restore <select> values on back/forward, so sync on load.
      applyFilters();

      bookButtons.forEach((button) => {
        button.addEventListener('click', () => openModal(button));
      });

      modalClose.addEventListener('click', closeModal);
      modalOverlay.addEventListener('click', (e) => {
        if (e.target === modalOverlay) closeModal();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && modalOverlay.classList.contains('visible')) {
          closeModal();
        }
      });
    });
  </script>
</body>
</html>
