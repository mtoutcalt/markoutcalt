---
/**
 * An ornament that stands on a bookshelf between books: a potted plant or a
 * picture frame. Purely decorative, so it is hidden from assistive tech.
 * Colours are fixed rather than themed because the wooden case they sit on
 * looks the same in light and dark mode. The bottom of each viewBox is the
 * shelf surface; the parent sets the rendered height.
 */
interface Props {
	kind: 'bush' | 'cactus' | 'frame' | 'topiary';
}

const { kind } = Astro.props;
---

{kind === 'bush' && (
	<svg class={`decor decor-${kind}`} viewBox="0 0 56 64" aria-hidden="true" focusable="false">
		<ellipse cx="28" cy="31" rx="23" ry="12" fill="#2d8444" />
		<circle cx="16" cy="27" r="10" fill="#3a9c55" />
		<circle cx="40" cy="27" r="10" fill="#3a9c55" />
		<circle cx="28" cy="21" r="13" fill="#46b062" />
		<circle cx="23" cy="15" r="4.5" fill="#72d08a" opacity="0.7" />
		<circle cx="37" cy="22" r="3" fill="#72d08a" opacity="0.5" />
		<rect x="15" y="39" width="26" height="6" rx="1.5" fill="#6d7a8d" />
		<path d="M17 45h22l-3 19H20z" fill="#566275" />
		<rect x="17" y="45" width="22" height="2" fill="#000" opacity="0.18" />
	</svg>
)}

{kind === 'cactus' && (
	<svg class={`decor decor-${kind}`} viewBox="0 0 40 72" aria-hidden="true" focusable="false">
		<path d="M14 34H11V25a3 3 0 0 0-6 0V36a5 5 0 0 0 5 5H14Z" fill="#3a9c55" />
		<path d="M26 28H29V20a3 3 0 0 1 6 0V31a5 5 0 0 1-5 5H26Z" fill="#3a9c55" />
		<rect x="14" y="10" width="12" height="46" rx="6" fill="#46b062" />
		<path d="M18 15V52M22 15V52" stroke="#2d8444" stroke-width="1" opacity="0.6" />
		<circle cx="20" cy="10" r="3" fill="#f38bb0" />
		<rect x="9" y="52" width="22" height="5" rx="1.5" fill="#6d7a8d" />
		<path d="M11 57h18l-2.5 15h-13z" fill="#566275" />
		<rect x="11" y="57" width="18" height="2" fill="#000" opacity="0.18" />
	</svg>
)}

{kind === 'topiary' && (
	<svg class={`decor decor-${kind}`} viewBox="0 0 44 72" aria-hidden="true" focusable="false">
		<rect x="21" y="30" width="2" height="17" fill="#6b4423" />
		<circle cx="22" cy="23" r="15" fill="#3a9c55" />
		<path d="M7 23a15 15 0 0 0 30 0a15 9 0 0 1-30 0z" fill="#2d8444" />
		<circle cx="16" cy="16" r="5" fill="#72d08a" opacity="0.6" />
		<rect x="11" y="46" width="22" height="6" rx="1.5" fill="#6d7a8d" />
		<path d="M13 52h18l-3 20H16z" fill="#566275" />
		<rect x="13" y="52" width="18" height="2" fill="#000" opacity="0.18" />
	</svg>
)}

{kind === 'frame' && (
	<svg class={`decor decor-${kind}`} viewBox="0 0 40 50" aria-hidden="true" focusable="false">
		<rect x="1" y="1" width="38" height="48" rx="3" fill="#dcaa48" stroke="#b2832c" stroke-width="2" />
		<rect x="7" y="7" width="26" height="36" rx="1" fill="#a9d1e6" />
		<circle cx="26" cy="15" r="3" fill="#fff6c8" />
		<path d="M7 37l8-10 6 6 5-5 7 7v8H7z" fill="#79b07c" />
		<rect x="7" y="7" width="26" height="36" rx="1" fill="none" stroke="#000" stroke-opacity="0.15" />
	</svg>
)}
