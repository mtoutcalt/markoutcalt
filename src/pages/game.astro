---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Game from '../components/tictactoe';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Games"
			description="Tic-tac-toe, built to experiment with embedding React in Astro."
		/>
		<!-- Unlisted: nothing links here and it is excluded from the sitemap
		     via UNLISTED_PATHS in astro.config.mjs. Keep the two in sync. -->
		<meta name="robots" content="noindex, nofollow" />
	</head>
	<body>
		<Header />
		<main>
			<h1>GAMES</h1>
			<p>Experimenting with embedding React in Astro</p>
            <Game client:load />
		</main>
		<Footer />
	</body>
</html>
